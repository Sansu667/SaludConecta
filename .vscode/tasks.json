{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar Java",
            "type": "shell",
            "command": "find ${workspaceFolder}/src/main/java -name '*.java' | xargs /usr/lib/jvm/java-21-openjdk/bin/javac -source 11 -target 11 -cp '${env:HOME}/.m2/repository/com/mysql/mysql-connector-j/8.0.33/mysql-connector-j-8.0.33.jar:${env:HOME}/.m2/repository/javax/servlet/javax.servlet-api/4.0.1/javax.servlet-api-4.0.1.jar:${env:HOME}/.m2/repository/javax/servlet/jstl/1.2/jstl-1.2.jar' -d ${workspaceFolder}/target/classes",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": "$javac"
        }
    ]
}
